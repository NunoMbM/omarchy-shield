#!/usr/bin/env bash
# /usr/bin/omarchy-shield-ctl
# Backend engine and JSON telemetry provider for omarchy-shield

set -euo pipefail

STATE_FILE="/run/omarchy-shield.state"
EXPIRY_FILE="/run/omarchy-shield.expiry"
DEVPORT_FILE="/run/omarchy-shield.devports"
UID_FILE="/run/omarchy-shield.uid"
TIMER_UNIT="omarchy-shield-lease"
SUDOERS_AI_FILE="/etc/sudoers.d/omarchy-passwordless"
UDEV_RULE_FILE="/run/udev/rules.d/99-omarchy-shield-usb.rules"

DRY_RUN="${OMARCHY_SHIELD_DRY_RUN:-0}"
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN=1
    shift
fi

ACTION="${1:-status}"

# ------------------------------------------------------------------------------
# 1. UNPRIVILEGED TELEMETRY (Runs every 5s from Quickshell without root)
# ------------------------------------------------------------------------------
if [[ "$ACTION" == "status" ]]; then
    MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "daily")
    DEV_PORTS=$(cat "$DEVPORT_FILE" 2>/dev/null || echo "0")
    PTRACE=$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo "1")
    DMESG=$(cat /proc/sys/kernel/dmesg_restrict 2>/dev/null || echo "1")
    LOCKDOWN=$(grep -o '\[.*\]' /sys/kernel/security/lockdown 2>/dev/null | tr -d '[]' || echo "none")

    SB_STATE="OFF"
    for var in /sys/firmware/efi/efivars/SecureBoot-*; do
        if [[ -e "$var" ]]; then
            VAL=$(od -An -t u1 -j 4 -N 1 "$var" 2>/dev/null | tr -d ' ')
            [[ "$VAL" == "1" ]] && SB_STATE="ON"
        fi
    done

    if lsblk -n -o TYPE 2>/dev/null | grep -q "crypt"; then
        LUKS_STATE="ENCRYPTED"
    else
        LUKS_STATE="UNENCRYPTED"
    fi

    if sudo -n true 2>/dev/null || [[ -f "$SUDOERS_AI_FILE" ]]; then
        SUDO_STATE="EXPOSED"
    else
        SUDO_STATE="LOCKED"
    fi

    OPEN_PORTS=$(ss -tulnH 2>/dev/null | awk '$5 !~ /^127\.|^\[::1\]|^(0\.0\.0\.0|\[::\]):5353$/ {c++} END {print c+0}')

    LEASE_REM=0
    if [[ -f "$EXPIRY_FILE" ]]; then
        EXPIRY=$(cat "$EXPIRY_FILE" 2>/dev/null || echo "0")
        NOW=$(date +%s)
        if (( EXPIRY > NOW )); then
            LEASE_REM=$(( (EXPIRY - NOW + 59) / 60 ))
        elif (( DRY_RUN == 0 )); then
            rm -f "$EXPIRY_FILE" 2>/dev/null || true
        fi
    fi

    printf '{"mode":"%s","ptrace":%d,"dmesg":%d,"lockdown":"%s","secure_boot":"%s","luks":"%s","sudo_state":"%s","open_ports":%d,"dev_ports":%d,"lease_rem":%d}\n' \
        "$MODE" "$PTRACE" "$DMESG" "$LOCKDOWN" "$SB_STATE" "$LUKS_STATE" "$SUDO_STATE" "$OPEN_PORTS" "$DEV_PORTS" "$LEASE_REM"
    exit 0
fi

# ------------------------------------------------------------------------------
# 2. STRICT INPUT VALIDATION (Runs BEFORE Polkit pkexec escalation)
# ------------------------------------------------------------------------------
case "$ACTION" in
    apply)
        TARGET_MODE="${2:-daily}"
        CUSTOM_PTRACE="${3:-1}"
        LEASE_ARG="${4:-keep}"
        ENABLE_DEV_PORTS="${5:-0}"

        if [[ ! "$TARGET_MODE" =~ ^(public|daily|lab)$ ]]; then
            echo "Error: Invalid mode '$TARGET_MODE'. Expected: public, daily, lab." >&2
            exit 1
        fi
        if [[ ! "$CUSTOM_PTRACE" =~ ^[12]$ ]]; then
            echo "Error: Invalid ptrace_scope '$CUSTOM_PTRACE'. Expected: 1 or 2." >&2
            exit 1
        fi
        if [[ ! "$LEASE_ARG" =~ ^(keep|[0-9]+)$ ]]; then
            echo "Error: Invalid lease argument '$LEASE_ARG'. Expected: 'keep' or integer 0-240." >&2
            exit 1
        fi
        if [[ "$LEASE_ARG" != "keep" ]] && (( LEASE_ARG < 0 || LEASE_ARG > 240 )); then
            echo "Error: Lease minutes must be between 0 and 240." >&2
            exit 1
        fi
        if [[ ! "$ENABLE_DEV_PORTS" =~ ^[01]$ ]]; then
            echo "Error: Invalid dev_ports flag '$ENABLE_DEV_PORTS'. Expected: 0 or 1." >&2
            exit 1
        fi
        ;;
    revoke-sudo|bios)
        ;;
    *)
        echo "Usage: omarchy-shield-ctl [--dry-run] {status|apply <public|daily|lab> <1|2> <lease_mins|keep> <0|1>|revoke-sudo|bios}" >&2
        exit 1
        ;;
esac

# ------------------------------------------------------------------------------
# 3. DRY-RUN EXECUTION & PRIVILEGE ESCALATION BOUNDARY
# ------------------------------------------------------------------------------
if (( DRY_RUN == 1 )); then
    case "$ACTION" in
        apply)
            printf '[DRY-RUN] apply mode=%s ptrace=%s lease=%s dev_ports=%s\n' \
                "$TARGET_MODE" "$CUSTOM_PTRACE" "$LEASE_ARG" "$ENABLE_DEV_PORTS"
            ;;
        revoke-sudo)
            printf '[DRY-RUN] revoke-sudo: clear /run/sudo/ts/* and %s\n' "$SUDOERS_AI_FILE"
            ;;
        bios)
            printf '[DRY-RUN] bios: systemctl reboot --firmware-setup\n'
            ;;
    esac
    exit 0
fi

if [[ "$ACTION" == "revoke-sudo" ]]; then
    sudo -k 2>/dev/null || true
fi

if [[ "$EUID" -ne 0 ]]; then
    exec pkexec "/usr/bin/omarchy-shield-ctl" "$@"
fi

# ------------------------------------------------------------------------------
# 4. HELPER FUNCTIONS (Root context)
# ------------------------------------------------------------------------------
resolve_target_uid() {
    # Priority 1: Direct caller UID provided by Polkit pkexec
    if [[ -n "${PKEXEC_UID:-}" && "${PKEXEC_UID}" -ne 0 ]]; then
        echo "${PKEXEC_UID}"
        return 0
    fi

    # Priority 2: Stored UID from the user who armed the active lease timer
    if [[ -f "$UID_FILE" ]]; then
        local saved_uid
        saved_uid=$(cat "$UID_FILE" 2>/dev/null || true)
        if [[ "$saved_uid" =~ ^[0-9]+$ && "$saved_uid" -ne 0 ]]; then
            echo "$saved_uid"
            return 0
        fi
    fi

    # Priority 3: Query systemd-logind for the currently active graphical session
    if command -v loginctl >/dev/null 2>&1; then
        local sid active type uid
        while read -r sid _ _ _ _; do
            [[ -z "$sid" ]] && continue
            active=$(loginctl show-session "$sid" -p Active --value 2>/dev/null || true)
            type=$(loginctl show-session "$sid" -p Type --value 2>/dev/null || true)
            uid=$(loginctl show-session "$sid" -p User --value 2>/dev/null || true)
            if [[ "$active" == "yes" && ( "$type" == "wayland" || "$type" == "x11" ) && "$uid" -ne 0 ]]; then
                echo "$uid"
                return 0
            fi
        done < <(loginctl list-sessions --no-legend 2>/dev/null)
    fi
}

notify_user() {
    local urgency="$1"
    local title="$2"
    local body="$3"

    command -v notify-send >/dev/null 2>&1 || return 0

    local target_uid
    target_uid=$(resolve_target_uid || true)

    if [[ -n "$target_uid" && -S "/run/user/${target_uid}/bus" ]]; then
        sudo -u "#${target_uid}" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${target_uid}/bus" \
            notify-send -a "Omarchy Shield" -u "$urgency" "$title" "$body" 2>/dev/null || true
    fi
}

clear_lease_timer() {
    systemctl stop "${TIMER_UNIT}.timer" 2>/dev/null || true
    if [[ "${SYSTEMD_EXEC_PID:-}" != "$$" ]]; then
        systemctl stop "${TIMER_UNIT}.service" 2>/dev/null || true
    fi
    systemctl reset-failed "${TIMER_UNIT}.timer" "${TIMER_UNIT}.service" 2>/dev/null || true
    rm -f "$EXPIRY_FILE" "$UID_FILE"
}

purge_sudo_cache() {
    rm -f "$SUDOERS_AI_FILE" 2>/dev/null || true
    rm -rf /run/sudo/ts/* 2>/dev/null || true
}

set_usb_power() {
    local target="$1"
    if [[ "$target" == "on" ]]; then
        mkdir -p /run/udev/rules.d
        printf 'ACTION=="add|bind", SUBSYSTEM=="usb", TEST=="power/control", ATTR{power/control}="on"\n' > "$UDEV_RULE_FILE"
    else
        rm -f "$UDEV_RULE_FILE" 2>/dev/null || true
    fi
    udevadm control --reload 2>/dev/null || true

    for ctrl in /sys/bus/usb/devices/*/power/control; do
        [[ -w "$ctrl" ]] && echo "$target" > "$ctrl" 2>/dev/null || true
    done
}

sync_dev_ports() {
    local enable="$1"
    if command -v ufw >/dev/null 2>&1; then
        if [[ "$enable" == "1" ]]; then
            ufw allow 1883/tcp comment 'OmarchyShield-MQTT' >/dev/null 2>&1 || true
            ufw allow 3333/tcp comment 'OmarchyShield-OpenOCD' >/dev/null 2>&1 || true
        else
            ufw delete allow 1883/tcp >/dev/null 2>&1 || true
            ufw delete allow 3333/tcp >/dev/null 2>&1 || true
        fi
    fi
    echo "$enable" > "$DEVPORT_FILE"
}

# ------------------------------------------------------------------------------
# 5. PRIVILEGED EXECUTION
# ------------------------------------------------------------------------------
case "$ACTION" in
    apply)
        case "$TARGET_MODE" in
            public)
                clear_lease_timer
                sysctl -w kernel.yama.ptrace_scope=2 >/dev/null
                sysctl -w kernel.dmesg_restrict=1 >/dev/null
                sysctl -w kernel.kptr_restrict=2 >/dev/null
                set_usb_power "auto"
                purge_sudo_cache
                if command -v ufw >/dev/null 2>&1; then
                    ufw default deny incoming >/dev/null 2>&1 || true
                fi
                sync_dev_ports "0"
                echo "public" > "$STATE_FILE"
                notify_user "normal" "Public / Travel Lockdown Active" "ptrace=2, dmesg hidden, dev ports closed."
                ;;

            daily)
                clear_lease_timer
                sysctl -w kernel.yama.ptrace_scope="$CUSTOM_PTRACE" >/dev/null
                sysctl -w kernel.dmesg_restrict=1 >/dev/null
                sysctl -w kernel.kptr_restrict=2 >/dev/null
                set_usb_power "auto"
                sync_dev_ports "$ENABLE_DEV_PORTS"
                echo "daily" > "$STATE_FILE"
                notify_user "low" "Daily Workstation Mode Active" "ptrace=${CUSTOM_PTRACE}, dmesg restricted, USB power auto."
                ;;

            lab)
                sysctl -w kernel.yama.ptrace_scope="$CUSTOM_PTRACE" >/dev/null
                sysctl -w kernel.dmesg_restrict=0 >/dev/null
                sysctl -w kernel.kptr_restrict=2 >/dev/null
                set_usb_power "on"
                sync_dev_ports "$ENABLE_DEV_PORTS"
                echo "lab" > "$STATE_FILE"

                if [[ "$LEASE_ARG" != "keep" ]]; then
                    clear_lease_timer
                    if (( LEASE_ARG > 0 )); then
                        NOW=$(date +%s)
                        echo $(( NOW + LEASE_ARG * 60 )) > "$EXPIRY_FILE"
                        if [[ -n "${PKEXEC_UID:-}" && "${PKEXEC_UID}" -ne 0 ]]; then
                            echo "${PKEXEC_UID}" > "$UID_FILE"
                        fi
                        systemd-run --unit="$TIMER_UNIT" --on-active="${LEASE_ARG}m" \
                            /usr/bin/omarchy-shield-ctl apply daily 1 0 0 >/dev/null 2>&1
                        notify_user "normal" "Lab & Gaming Mode Active (${LEASE_ARG}m Lease)" "USB autosuspend OFF, dmesg unlocked, ptrace=${CUSTOM_PTRACE}."
                    else
                        notify_user "normal" "Lab & Gaming Mode Active (Until Reboot)" "USB autosuspend OFF, dmesg unlocked, ptrace=${CUSTOM_PTRACE}."
                    fi
                else
                    notify_user "low" "Lab Parameters Updated" "ptrace=${CUSTOM_PTRACE}, Dev Ports=${ENABLE_DEV_PORTS} (Lease timer preserved)."
                fi
                ;;
        esac
        ;;

    revoke-sudo)
        purge_sudo_cache
        notify_user "normal" "Sudo & AI Cache Purged" "Cleared all sudo TTY tokens and removed passwordless rules."
        ;;

    bios)
        notify_user "critical" "Rebooting to UEFI" "System is restarting into firmware setup..."
        systemctl reboot --firmware-setup
        ;;
esac
