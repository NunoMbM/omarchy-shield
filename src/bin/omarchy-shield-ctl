#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="/run/omarchy-shield.state"
EXPIRY_FILE="/run/omarchy-shield.expiry"
DEVPORT_FILE="/run/omarchy-shield.devports"
TIMER_UNIT="omarchy-shield-lease"
ACTION="${1:-status}"

# 1. UNPRIVILEGED TELEMETRY
if [[ "$ACTION" == "status" ]]; then
    MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "daily")
    DEV_PORTS=$(cat "$DEVPORT_FILE" 2>/dev/null || echo "0")
    PTRACE=$(cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null || echo "1")
    DMESG=$(cat /proc/sys/kernel/dmesg_restrict 2>/dev/null || echo "1")
    LOCKDOWN=$(grep -o '\[.*\]' /sys/kernel/security/lockdown 2>/dev/null | tr -d '[]' || echo "none")

    SB_STATE="OFF"
    for var in /sys/firmware/efi/efivars/SecureBoot-*; do
        if [[ -e "$var" ]]; then
            VAL=$(od -An -t u1 -j 4 -N 1 "$var" 2>/dev/null | tr -d ' ')
            [[ "$VAL" == "1" ]] && SB_STATE="ON"
        fi
    done

    if lsblk -n -o TYPE 2>/dev/null | grep -q "crypt"; then
        LUKS_STATE="ENCRYPTED"
    else
        LUKS_STATE="UNENCRYPTED"
    fi

    if sudo -n true 2>/dev/null || ls /etc/sudoers.d/*passwordless* >/dev/null 2>&1; then
        SUDO_STATE="EXPOSED"
    else
        SUDO_STATE="LOCKED"
    fi

    OPEN_PORTS=$(ss -tulnH 2>/dev/null | awk '$5 !~ /^127\.|^\[::1\]|^0\.0\.0\.0:5353/ {c++} END {print c+0}')

    LEASE_REM=0
    if [[ -f "$EXPIRY_FILE" ]]; then
        EXPIRY=$(cat "$EXPIRY_FILE" 2>/dev/null || echo "0")
        NOW=$(date +%s)
        if (( EXPIRY > NOW )); then
            LEASE_REM=$(( (EXPIRY - NOW + 59) / 60 ))
        else
            rm -f "$EXPIRY_FILE" 2>/dev/null || true
        fi
    fi

    printf '{"mode":"%s","ptrace":%d,"dmesg":%d,"lockdown":"%s","secure_boot":"%s","luks":"%s","sudo_state":"%s","open_ports":%d,"dev_ports":%d,"lease_rem":%d}\n' \
        "$MODE" "$PTRACE" "$DMESG" "$LOCKDOWN" "$SB_STATE" "$LUKS_STATE" "$SUDO_STATE" "$OPEN_PORTS" "$DEV_PORTS" "$LEASE_REM"
    exit 0
fi

# 2. PRIVILEGE ESCALATION
if [[ "$ACTION" == "revoke-sudo" ]]; then
    sudo -k 2>/dev/null || true
    if ! ls /etc/sudoers.d/*passwordless* >/dev/null 2>&1; then
        exit 0
    fi
fi

if [[ "$EUID" -ne 0 ]]; then
    exec pkexec "/usr/bin/omarchy-shield-ctl" "$@"
fi

clear_lease_timer() {
    systemctl stop "${TIMER_UNIT}.timer" "${TIMER_UNIT}.service" 2>/dev/null || true
    systemctl reset-failed "${TIMER_UNIT}.timer" "${TIMER_UNIT}.service" 2>/dev/null || true
    rm -f "$EXPIRY_FILE"
}

set_usb_power() {
    local target="$1"
    for ctrl in /sys/bus/usb/devices/*/power/control; do
        [[ -w "$ctrl" ]] && echo "$target" > "$ctrl" 2>/dev/null || true
    done
}

# 3. PRIVILEGED MUTATIONS
case "$ACTION" in
    apply)
        TARGET_MODE="${2:-daily}"
        CUSTOM_PTRACE="${3:-1}"
        LEASE_MINS="${4:-0}"
        ENABLE_DEV_PORTS="${5:-0}"

        clear_lease_timer

        case "$TARGET_MODE" in
            public)
                sysctl -w kernel.yama.ptrace_scope=2 >/dev/null
                sysctl -w kernel.dmesg_restrict=1 >/dev/null
                sysctl -w kernel.kptr_restrict=2 >/dev/null
                set_usb_power "auto"
                rm -f /etc/sudoers.d/*passwordless* 2>/dev/null || true
                if command -v ufw >/dev/null 2>&1; then
                    ufw default deny incoming >/dev/null 2>&1 || true
                    ufw delete allow 1883/tcp >/dev/null 2>&1 || true
                    ufw delete allow 3333/tcp >/dev/null 2>&1 || true
                fi
                echo "0" > "$DEVPORT_FILE"
                echo "public" > "$STATE_FILE"
                ;;

            daily)
                sysctl -w kernel.yama.ptrace_scope="$CUSTOM_PTRACE" >/dev/null
                sysctl -w kernel.dmesg_restrict=1 >/dev/null
                sysctl -w kernel.kptr_restrict=2 >/dev/null
                set_usb_power "auto"
                if command -v ufw >/dev/null 2>&1 && [[ "$ENABLE_DEV_PORTS" == "0" ]]; then
                    ufw delete allow 1883/tcp >/dev/null 2>&1 || true
                    ufw delete allow 3333/tcp >/dev/null 2>&1 || true
                fi
                echo "$ENABLE_DEV_PORTS" > "$DEVPORT_FILE"
                echo "daily" > "$STATE_FILE"
                ;;

            lab)
                sysctl -w kernel.yama.ptrace_scope="$CUSTOM_PTRACE" >/dev/null
                sysctl -w kernel.dmesg_restrict=0 >/dev/null
                set_usb_power "on"
                if command -v ufw >/dev/null 2>&1; then
                    if [[ "$ENABLE_DEV_PORTS" == "1" ]]; then
                        ufw allow 1883/tcp comment 'OmarchyShield-MQTT' >/dev/null 2>&1 || true
                        ufw allow 3333/tcp comment 'OmarchyShield-OpenOCD' >/dev/null 2>&1 || true
                    else
                        ufw delete allow 1883/tcp >/dev/null 2>&1 || true
                        ufw delete allow 3333/tcp >/dev/null 2>&1 || true
                    fi
                fi
                echo "$ENABLE_DEV_PORTS" > "$DEVPORT_FILE"
                echo "lab" > "$STATE_FILE"

                if (( LEASE_MINS > 0 )); then
                    NOW=$(date +%s)
                    echo $(( NOW + LEASE_MINS * 60 )) > "$EXPIRY_FILE"
                    systemd-run --unit="$TIMER_UNIT" --on-active="${LEASE_MINS}m" \
                        /usr/bin/omarchy-shield-ctl apply daily 1 0 0 >/dev/null 2>&1
                fi
                ;;
        esac
        ;;

    revoke-sudo)
        rm -f /etc/sudoers.d/*passwordless* 2>/dev/null || true
        ;;

    bios)
        systemctl reboot --firmware-setup
        ;;

    *)
        echo "Usage: omarchy-shield-ctl {status|apply <mode> <ptrace> <lease_mins> <dev_ports>|revoke-sudo|bios}"
        exit 1
        ;;
esac
